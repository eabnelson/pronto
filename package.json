{
  "name": "pronto-workspace",
  "version": "0.4.2",
  "description": "An iMessage bridge for local coding agents and optional Conductor Cloud workspaces",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/eabnelson/pronto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eabnelson/pronto.git"
  },
  "bugs": {
    "url": "https://github.com/eabnelson/pronto/issues"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "keywords": [
    "imessage",
    "codex",
    "claude-code",
    "macos"
  ],
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "setup": "bun run ./packages/cli/src/cli.ts setup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test ./test/integration",
    "release:validate": "bun test ./test/unit/runtime-adapters.test.ts ./test/unit/runtime-qualification.test.ts && bun ./scripts/release-validate.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "pronto-imessage": "workspace:*",
    "pronto-imessage-v0-2-0": "npm:pronto-imessage@0.2.0",
    "pronto-imessage-v0-4-1": "npm:pronto-imessage@0.4.1",
    "typescript": "7.0.2"
  }
}
