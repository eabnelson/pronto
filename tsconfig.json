{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "pronto-imessage": ["./packages/messages/src/index.ts"],
      "pronto-imessage/tags": ["./packages/messages/src/tags.ts"]
    },
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
